{
  "name": "@nulist/sdk",
  "version": "0.1.2",
  "description": "Zero-dependency TypeScript SDK for the nulist REST API — send emails, manage contacts, lists, broadcasts and templates.",
  "keywords": [
    "nulist",
    "email",
    "newsletter",
    "transactional-email",
    "sdk",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "tsdown": "0.23.7",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
