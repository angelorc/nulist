# Copy to .env.prod and fill in. Used by docker-compose.prod.yml.

POSTGRES_USER=nulist
# openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_DB=nulist

NUXT_PUBLIC_SITE_URL=http://localhost:3000
# openssl rand -base64 48
NUXT_BETTER_AUTH_SECRET=
# openssl rand -base64 48
NUXT_APP_SECRET=

# Published port of the web container (keep on loopback behind a reverse proxy)
WEB_BIND=127.0.0.1
WEB_PORT=3000

# SES events are accepted only from these SNS topics (comma-separated)
NUXT_SNS_TOPIC_ARNS=

# Reverse proxies whose X-Forwarded-For is trusted (IPs, CIDRs or "loopback")
# With --profile caddy: 172.16.0.0/12 (Docker bridge range)
NULIST_TRUSTED_PROXIES=
NULIST_ALLOW_PRIVATE_TARGETS=false
NULIST_ALLOWED_TARGETS=

# Instance-wide SMTP / S3 defaults
NULIST_SMTP_HOST=
NULIST_SMTP_PORT=587
NULIST_S3_ENDPOINT=
NULIST_S3_REGION=us-east-1
NULIST_S3_BUCKET=nulist
NULIST_S3_ACCESS_KEY_ID=
NULIST_S3_SECRET_ACCESS_KEY=
NULIST_S3_PUBLIC_URL=

# Workflow queue: keep concurrency <= pool size
WORKFLOW_POSTGRES_WORKER_CONCURRENCY=10
WORKFLOW_POSTGRES_MAX_POOL_SIZE=10
