{
  "name": "@nulist/web",
  "version": "0.2.1",
  "description": "nulist dashboard, REST API and durable background workers. Nuxt 4 app backed by Postgres.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "workflow:bootstrap": "bootstrap",
    "workflow:web": "workflow web --backend @workflow/world-postgres",
    "seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/db.ts reset",
    "db:demo": "tsx scripts/db.ts demo",
    "test": "vitest run",
    "auth:generate": "auth generate --config scripts/auth-cli.ts --output server/db/auth-schema.ts --yes",
    "db:setup": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "build:migrate": "esbuild scripts/migrate.ts --bundle --platform=node --format=esm --target=node24 --minify --external:typescript --external:pg-native --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\" --splitting --out-extension:.js=.mjs --outdir=dist/migrate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/client-sesv2": "^3.1164.0",
    "@better-auth/api-key": "1.7.18",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-xml": "^6.1.0",
    "@iconify-json/logos": "^1.2.19",
    "@iconify-json/lucide": "^1.2.152",
    "@iconify-json/simple-icons": "^1.2.102",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/better-auth": "0.3.16",
    "@tanstack/charts": "^1.5.0",
    "@tanstack/table-core": "^8.21.3",
    "@templatical/editor": "0.59.1",
    "@templatical/import-mjml": "0.59.1",
    "@templatical/quality": "0.59.1",
    "@templatical/renderer": "0.59.1",
    "@templatical/types": "0.59.1",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "@workflow/world-postgres": "5.1.1",
    "better-auth": "1.7.18",
    "cheerio": "1.2.0",
    "codemirror": "^6.0.2",
    "date-fns": "^4.4.0",
    "domhandler": "5.0.3",
    "drizzle-orm": "^0.45.4",
    "entities": "7.0.1",
    "html-to-text": "^10.0.1",
    "jose": "^6.2.16",
    "liquidjs": "^10.30.1",
    "mjml": "^5.4.1",
    "nodemailer": "^10.4.0",
    "nuxt": "^4.6.4",
    "p-throttle": "^8.1.1",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "rate-limiter-flexible": "^11.4.0",
    "sns-payload-validator": "^2.1.0",
    "standardwebhooks": "^1.1.1",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.45",
    "vue-codemirror": "^6.1.1",
    "workflow": "5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nulist/sdk": "workspace:*",
    "@types/html-to-text": "^9.0.4",
    "@types/mjml": "^5.4.2",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.15.0",
    "auth": "1.7.18",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
