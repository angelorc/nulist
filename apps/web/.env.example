NUXT_DATABASE_URL=postgres://mlist:mlist@localhost:5442/mlist
NUXT_BETTER_AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-chars
NUXT_APP_SECRET=change-me-to-another-random-string-of-32-chars
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# SES events are accepted only from these SNS topics (comma-separated; empty = none)
NUXT_SNS_TOPIC_ARNS=
# Reverse proxies whose X-Forwarded-For is trusted (IPs, CIDRs or "loopback"; empty = none)
MLIST_TRUSTED_PROXIES=
# Organization webhooks, SMTP and S3 hosts may not reach private networks unless allowed here
MLIST_ALLOW_PRIVATE_TARGETS=false
MLIST_ALLOWED_TARGETS=

WORKFLOW_TARGET_WORLD=@workflow/world-postgres
WORKFLOW_POSTGRES_URL=postgres://mlist:mlist@localhost:5442/mlist

# Development defaults (docker compose): Mailpit SMTP + RustFS S3
MLIST_SMTP_HOST=localhost
MLIST_SMTP_PORT=1026
MLIST_S3_ENDPOINT=http://localhost:9000
MLIST_S3_BUCKET=mlist
MLIST_S3_ACCESS_KEY_ID=mlist
MLIST_S3_SECRET_ACCESS_KEY=mlist-secret
MLIST_S3_PUBLIC_URL=http://localhost:9000/mlist
