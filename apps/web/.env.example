NUXT_DATABASE_URL=postgres://nulist:nulist@localhost:5442/nulist
NUXT_BETTER_AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-chars
NUXT_APP_SECRET=change-me-to-another-random-string-of-32-chars
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# SES events are accepted only from these SNS topics (comma-separated; empty = none)
NUXT_SNS_TOPIC_ARNS=
# Reverse proxies whose X-Forwarded-For is trusted (IPs, CIDRs or "loopback"; empty = none)
NULIST_TRUSTED_PROXIES=
# Organization webhooks, SMTP and S3 hosts may not reach private networks unless allowed here
NULIST_ALLOW_PRIVATE_TARGETS=false
NULIST_ALLOWED_TARGETS=

WORKFLOW_TARGET_WORLD=@workflow/world-postgres
WORKFLOW_POSTGRES_URL=postgres://nulist:nulist@localhost:5442/nulist

# Development defaults (docker compose): Mailpit SMTP + RustFS S3
NULIST_SMTP_HOST=localhost
NULIST_SMTP_PORT=1026
NULIST_S3_ENDPOINT=http://localhost:9000
NULIST_S3_BUCKET=nulist
NULIST_S3_ACCESS_KEY_ID=nulist
NULIST_S3_SECRET_ACCESS_KEY=nulist-secret
NULIST_S3_PUBLIC_URL=http://localhost:9000/nulist
